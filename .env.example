# Tailscale
TS_AUTHKEY=tskey-auth-YOUR_AUTH_KEY
TS_HOSTNAME=bif-server
TS_STATE_DIR=/var/lib/tailscale
TS_USERSPACE=true

# MongoDB (container initialization)
MONGO_INITDB_ROOT_PASSWORD=pass
MONGO_INITDB_ROOT_USERNAME=admin

# Mongo-Express (optional)
ME_CONFIG_MONGODB_ADMINPASSWORD=pass
ME_CONFIG_MONGODB_ADMINUSERNAME=admin
ME_CONFIG_MONGODB_URL=mongodb://admin:pass@mongodb:27017/

# Map Data Configuration
OSRM_MAP_URLS=https://download.geofabrik.de/asia/vietnam-latest.osm.pbf
OVERTURE_BBOX=102.14,8.56,109.46,23.39

# Spring / Server
OSRM_BASE_URL=http://osrm:5000
SPRING_MONGODB_URI=mongodb://admin:pass@mongodb:27017/bif_db?authSource=admin
SPRING_PROFILES_ACTIVE=docker

# Security
SECURITY_JWT_SECRET=ChangeMeToALongerJwtSecretKeyForDevOnly123456789

# Cloudinary (media uploads)
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Search provider (mongo or typesense)
PLACE_SEARCH_PROVIDER=mongo
APP_BOOTSTRAP_BATCH_SIZE=1000
APP_BOOTSTRAP_BATCH_WRITE_MAX_ATTEMPTS=3
APP_BOOTSTRAP_BATCH_WRITE_RETRY_BACKOFF_MS=500
APP_BOOTSTRAP_BATCH_WRITE_MAX_BACKOFF_MS=5000

# Typesense (Search)
TYPESENSE_API_KEY=REPLACE_WITH_A_STRONG_RANDOM_KEY
TYPESENSE_BOOTSTRAP_REINDEX_ON_STARTUP=false
TYPESENSE_CONNECT_TIMEOUT_MS=3000
TYPESENSE_ENABLED=false
TYPESENSE_HOST=typesense
TYPESENSE_PLACES_COLLECTION=places
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_READ_TIMEOUT_MS=5000

# AI / Ollama
AI_GUARD_AUTH_REQUIRED=true
AI_GUARD_MAX_REQUESTS_PER_WINDOW=5
AI_GUARD_RATE_LIMIT_WINDOW_SECONDS=60
AI_LIVE_SMOKE_BASE_URL=http://localhost:8080
AI_LIVE_SMOKE_ENABLED=false
AI_LIVE_SMOKE_PASSWORD=Password123!
AI_OLLAMA_RETRY_COUNT=1
AI_OLLAMA_TEMPERATURE=0.1
AI_OLLAMA_TIMEOUT_MS=65000
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# Optional / overrides
PLACE_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
PLACE_GEOCODING_USER_AGENT=bif-mobile-app-server/1.0

# Container memory limits
BIF_SERVER_JAVA_TOOL_OPTIONS="-XX:InitialRAMPercentage=25.0 -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -XX:+UseStringDeduplication -XX:+ExitOnOutOfMemoryError"
BIF_SERVER_MEM_LIMIT=1024m
DOZZLE_MEM_LIMIT=128m
MONGODB_MEM_LIMIT=768m
MONGO_EXPRESS_MEM_LIMIT=256m
OLLAMA_INIT_MEM_LIMIT=256m
OLLAMA_MEM_LIMIT=8192m
OPEN_WEBUI_MEM_LIMIT=1024m
OSRM_MEM_LIMIT=2048m
TAILSCALE_MEM_LIMIT=128m
TYPESENSE_MEM_LIMIT=1024m
