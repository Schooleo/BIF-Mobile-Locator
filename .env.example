# Tailscale
TS_HOSTNAME=bif-server
TS_AUTHKEY=tskey-auth-YOUR_AUTH_KEY
TS_STATE_DIR=./tailscale-state
TS_USERSPACE=true

# MongoDB (container initialization)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=pass

# Mongo-Express (optional)
ME_CONFIG_MONGODB_ADMINUSERNAME=admin
ME_CONFIG_MONGODB_ADMINPASSWORD=pass
ME_CONFIG_MONGODB_URL=mongodb://admin:pass@mongodb:27017/

# Spring / Server
SPRING_PROFILES_ACTIVE=docker
SPRING_MONGODB_URI=mongodb://admin:pass@mongodb:27017/bif_db?authSource=admin

# Security
SECURITY_JWT_SECRET=ChangeMeToALongerJwtSecretKeyForDevOnly123456789

# Search provider (mongo or typesense)
PLACE_SEARCH_PROVIDER=mongo     

# Typesense (Search)
TYPESENSE_ENABLED=false
TYPESENSE_PROTOCOL=http
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=REPLACE_WITH_A_STRONG_RANDOM_KEY
TYPESENSE_PLACES_COLLECTION=places
TYPESENSE_CONNECT_TIMEOUT_MS=3000
TYPESENSE_READ_TIMEOUT_MS=5000
TYPESENSE_BOOTSTRAP_REINDEX_ON_STARTUP=false

# AI / Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# Optional / overrides
PLACE_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
PLACE_GEOCODING_USER_AGENT=bif-mobile-app-server/1.0