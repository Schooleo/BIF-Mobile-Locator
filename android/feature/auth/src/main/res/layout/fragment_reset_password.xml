<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorScreenBackground"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="start"
        android:padding="6dp"
        android:src="@drawable/ic_arrow_back"
        android:tint="?attr/colorOnBackground"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back_to_login" />

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_logo_placeholder">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:contentDescription="@string/reset_password_title"
            android:src="@drawable/ic_lock"
            android:tint="?attr/colorHintText" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reset_password_title"
        android:textColor="?attr/colorOnBackground"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="@string/reset_password_subtitle"
        android:textColor="?attr/colorHintText"
        android:textSize="14sp" />

    <include
        layout="@layout/component_input_password"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <include
        layout="@layout/component_input_confirm_password"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <include
        android:id="@+id/btn_reset_password"
        layout="@layout/component_primary_button"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

</LinearLayout>
