<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorScreenBackground"
    android:gravity="center_horizontal"
    android:padding="32dp">

    <ImageView
        android:id="@+id/iv_profile"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="end"
        android:padding="4dp"
        android:src="@drawable/ic_person"
        app:tint="@color/primary_green"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/my_profile" />

    <!-- Logo -->
    <include layout="@layout/component_logo" />

    <!-- Email Input -->
    <include layout="@layout/component_input_email" />

    <!-- Password Input -->
    <include
        layout="@layout/component_input_password"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="20dp" />

    <!-- Log in Button -->
    <include
        android:id="@+id/btn_login"
        layout="@layout/component_primary_button"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Register Link -->
        <include
            android:id="@+id/tv_register_link"
            layout="@layout/component_auth_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Forgot Password Link -->
        <include
            android:id="@+id/tv_forgot_password_link"
            layout="@layout/component_auth_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

</LinearLayout>
