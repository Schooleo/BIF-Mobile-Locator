<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:backgroundTint="?attr/colorScreenBackground"
    android:orientation="vertical"
    android:padding="@dimen/social_dialog_padding">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="@string/create_trip"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="@dimen/social_icon_button_size"
            android:layout_height="@dimen/social_icon_button_size"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close" />
    </RelativeLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/social_spacing_md"
        android:text="@string/trip_title_hint"
        android:textColor="?attr/colorTextPrimary"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_trip_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/social_spacing_xs"
        android:background="@drawable/bg_search_input"
        android:backgroundTint="?attr/colorListItemBackground"
        android:hint="@string/trip_title_hint"
        android:maxLines="1"
        android:padding="@dimen/social_spacing_md"
        android:textColor="?attr/colorTextPrimary"
        android:textColorHint="?attr/colorTextSecondary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/social_spacing_md"
        android:text="@string/trip_description_hint"
        android:textColor="?attr/colorTextPrimary"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_trip_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/social_spacing_xs"
        android:background="@drawable/bg_search_input"
        android:backgroundTint="?attr/colorListItemBackground"
        android:gravity="top"
        android:hint="@string/trip_description_hint"
        android:inputType="textMultiLine"
        android:maxLines="5"
        android:minLines="3"
        android:padding="@dimen/social_spacing_md"
        android:textColor="?attr/colorTextPrimary"
        android:textColorHint="?attr/colorTextSecondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/social_spacing_md"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/start_date"
                android:textColor="?attr/colorTextPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_start_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/social_spacing_xs"
                android:background="@drawable/bg_search_input"
                android:backgroundTint="?attr/colorListItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/social_spacing_md"
                android:text="@string/start_date"
                android:textColor="?attr/colorTextPrimary"
                android:textColorHint="?attr/colorTextSecondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/social_trip_card_margin_vertical"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/end_date"
                android:textColor="?attr/colorTextPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_end_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/social_spacing_xs"
                android:background="@drawable/bg_search_input"
                android:backgroundTint="?attr/colorListItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/social_spacing_md"
                android:text="@string/end_date"
                android:textColor="?attr/colorTextPrimary"
                android:textColorHint="?attr/colorTextSecondary" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_create_trip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/social_dialog_primary_button_height"
        android:layout_marginTop="@dimen/social_spacing_lg"
        android:background="@drawable/bg_dialog_button"
        android:stateListAnimator="@null"
        android:text="@string/create_trip"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="16sp"/>

</LinearLayout>
