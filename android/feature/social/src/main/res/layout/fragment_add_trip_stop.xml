<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/add_stop_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorScreenBackground">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map_view_add_stop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/layout_top_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_gravity="top"
        android:elevation="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layout_title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:backgroundTint="?attr/colorListItemBackground"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <ImageButton
                android:id="@+id/btn_add_stop_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/go_back"
                android:src="@drawable/ic_back"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/trip_select_place"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_search_box"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ai_search_box_default"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/search"
                android:src="@drawable/ic_search"
                app:tint="?attr/colorHintText" />

            <EditText
                android:id="@+id/et_search_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/trip_search_places_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorHintText" />

            <ImageButton
                android:id="@+id/btn_clear_search"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/close"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="?attr/colorOnSurface"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_ai_toggle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_ai_toggle_sparkle"
                android:contentDescription="@string/trip_ai_toggle"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/white" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_ai_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ai_status_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="@string/trip_ai_loading"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/layout_search_results_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/colorSurface"
            android:backgroundTint="?attr/colorListItemBackground"
            android:elevation="6dp"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_search_results"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/trip_ai_empty_state"
                android:textColor="?attr/colorTextSecondary"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="108dp"
        android:layout_marginBottom="220dp"
        android:clickable="false"
        android:focusable="false">

        <ImageButton
            android:id="@+id/btn_previous_place"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_trip_stop_nav_button"
            android:contentDescription="@string/trip_previous_place"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:visibility="gone"
            app:tint="@color/primary_green" />

        <ImageButton
            android:id="@+id/btn_next_place"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_trip_stop_nav_button"
            android:contentDescription="@string/trip_next_place"
            android:padding="10dp"
            android:rotation="180"
            android:src="@drawable/ic_back"
            android:visibility="gone"
            app:tint="@color/primary_green" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/bottom_sheet_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true"
        app:behavior_peekHeight="180dp">

        <LinearLayout
            android:id="@+id/layout_bottom_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_add_trip_stop_sheet"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="?attr/colorHintText" />

            <LinearLayout
                android:id="@+id/layout_selected_place"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_add_trip_stop_result"
                android:backgroundTint="?attr/colorListItemBackground"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_selected_place_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/trip_select_place"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/ic_star_circle"
                        android:backgroundTint="@color/primary_green"
                        android:contentDescription="@string/add_stop"
                        app:tint="@color/white" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_selected_place_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_selected_place_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/yellow_primary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/trip_stop_date_label"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_selected_date"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_ai_search_box_default"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/trip_stop_time_label"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_selected_time"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_ai_search_box_default"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_to_trip"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/add_stop"
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary_green" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
