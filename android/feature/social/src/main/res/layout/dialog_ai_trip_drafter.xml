<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:backgroundTint="?attr/colorScreenBackground"
    android:orientation="vertical"
    android:padding="@dimen/social_dialog_padding">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_ai_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="@string/trip_ai_drafter_title"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="@dimen/social_icon_button_size"
            android:layout_height="@dimen/social_icon_button_size"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorTextSecondary" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layout_ai_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/social_spacing_md"
        android:orientation="vertical">

        <EditText
            android:id="@+id/et_ai_request"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search_input"
            android:backgroundTint="?attr/colorListItemBackground"
            android:hint="@string/trip_ai_drafter_hint"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minLines="3"
            android:padding="@dimen/social_spacing_md"
            android:textColor="?attr/colorTextPrimary"
            android:textColorHint="?attr/colorTextSecondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/social_spacing_md"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_ai_start_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_search_input"
                android:backgroundTint="?attr/colorListItemBackground"
                android:clickable="true"
                android:contentDescription="@string/trip_ai_start_date_not_set"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:hint="@string/start_date"
                android:padding="@dimen/social_spacing_md"
                android:textColor="?attr/colorTextPrimary"
                android:textColorHint="?attr/colorTextSecondary" />

            <TextView
                android:id="@+id/tv_ai_end_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/social_spacing_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_search_input"
                android:backgroundTint="?attr/colorListItemBackground"
                android:clickable="true"
                android:contentDescription="@string/trip_ai_end_date_not_set"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:hint="@string/end_date"
                android:padding="@dimen/social_spacing_md"
                android:textColor="?attr/colorTextPrimary"
                android:textColorHint="?attr/colorTextSecondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/social_spacing_md"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_ai_clear"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/social_dialog_primary_button_height"
                android:backgroundTint="?attr/colorListItemBackground"
                android:minWidth="96dp"
                android:text="@string/trip_ai_clear"
                android:textAllCaps="false"
                android:textColor="?attr/colorTextPrimary" />

            <Button
                android:id="@+id/btn_ai_send"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/social_dialog_primary_button_height"
                android:layout_marginStart="@dimen/social_spacing_md"
                android:background="@drawable/bg_dialog_button"
                android:minWidth="96dp"
                android:text="@string/chat_send"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnPrimary"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_ai_loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/social_spacing_lg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_ai_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/social_spacing_md"
            android:gravity="center"
            android:text="@string/trip_ai_loading_drafter"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_ai_loading_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/social_spacing_md"
            android:text="@string/go_back"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_ai_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/social_spacing_md"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_ai_result_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trip_ai_drafter_result"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_ai_result_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/social_spacing_xs"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_ai_result_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/social_spacing_xs"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_ai_result_stop_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/social_spacing_md"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_ai_result_stops"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="@dimen/social_spacing_xs"
            android:clipToPadding="false"
            android:paddingEnd="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/social_spacing_md"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_ai_retry"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/social_dialog_primary_button_height"
                android:backgroundTint="?attr/colorListItemBackground"
                android:minWidth="96dp"
                android:text="@string/trip_ai_retry"
                android:textAllCaps="false"
                android:textColor="?attr/colorTextPrimary" />

            <Button
                android:id="@+id/btn_ai_save"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/social_dialog_primary_button_height"
                android:layout_marginStart="@dimen/social_spacing_md"
                android:background="@drawable/bg_dialog_button"
                android:minWidth="96dp"
                android:text="@string/chat_save_trip"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnPrimary"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_ai_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/social_spacing_md"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_ai_error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search_input"
            android:backgroundTint="?attr/colorListItemBackground"
            android:padding="@dimen/social_spacing_md"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_ai_error_request"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/social_spacing_md"
            android:background="@drawable/bg_search_input"
            android:backgroundTint="?attr/colorListItemBackground"
            android:hint="@string/trip_ai_drafter_hint"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minLines="3"
            android:padding="@dimen/social_spacing_md"
            android:textColor="?attr/colorTextPrimary"
            android:textColorHint="?attr/colorTextSecondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/social_spacing_md"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_ai_error_start_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_search_input"
                android:backgroundTint="?attr/colorListItemBackground"
                android:clickable="true"
                android:contentDescription="@string/trip_ai_start_date_not_set"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:hint="@string/start_date"
                android:padding="@dimen/social_spacing_md"
                android:textColor="?attr/colorTextPrimary"
                android:textColorHint="?attr/colorTextSecondary" />

            <TextView
                android:id="@+id/tv_ai_error_end_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/social_spacing_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_search_input"
                android:backgroundTint="?attr/colorListItemBackground"
                android:clickable="true"
                android:contentDescription="@string/trip_ai_end_date_not_set"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:hint="@string/end_date"
                android:padding="@dimen/social_spacing_md"
                android:textColor="?attr/colorTextPrimary"
                android:textColorHint="?attr/colorTextSecondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/social_spacing_md"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_ai_error_clear"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/social_dialog_primary_button_height"
                android:backgroundTint="?attr/colorListItemBackground"
                android:minWidth="96dp"
                android:text="@string/trip_ai_clear"
                android:textAllCaps="false"
                android:textColor="?attr/colorTextPrimary" />

            <Button
                android:id="@+id/btn_ai_error_send"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/social_dialog_primary_button_height"
                android:layout_marginStart="@dimen/social_spacing_md"
                android:background="@drawable/bg_dialog_button"
                android:minWidth="96dp"
                android:text="@string/chat_send"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnPrimary"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
