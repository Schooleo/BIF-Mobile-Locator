<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:backgroundTint="?attr/colorScreenBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trip_stop_edit_title"
        android:textColor="?attr/colorTextPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/trip_stop_notes_label_plain"
        android:textColor="?attr/colorTextPrimary"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_edit_stop_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_search_input"
        android:backgroundTint="?attr/colorListItemBackground"
        android:hint="@string/trip_stop_no_note"
        android:inputType="textMultiLine"
        android:maxLines="4"
        android:minLines="2"
        android:padding="12dp"
        android:textColor="?attr/colorTextPrimary"
        android:textColorHint="?attr/colorTextSecondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:baselineAligned="false" android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/trip_stop_date_label"
                android:textColor="?attr/colorTextPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_edit_stop_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search_input"
                android:backgroundTint="?attr/colorListItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:textColor="?attr/colorTextPrimary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/trip_stop_time_label"
                android:textColor="?attr/colorTextPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_edit_stop_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search_input"
                android:backgroundTint="?attr/colorListItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:textColor="?attr/colorTextPrimary" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_stop_cancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_stop_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/save"
            app:backgroundTint="?attr/colorPrimary"
            app:icon="@drawable/ic_edit"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconTint="?attr/colorOnPrimary"
            android:textColor="?attr/colorOnPrimary"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>

</LinearLayout>
