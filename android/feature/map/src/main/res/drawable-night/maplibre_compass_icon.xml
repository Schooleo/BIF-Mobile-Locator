<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/dark_mode_box" />
            <stroke
                android:width="1dp"
                android:color="@color/dark_mode_background_secondary" />
        </shape>
    </item>
    <item
        android:width="26dp"
        android:height="26dp"
        android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@android:drawable/ic_menu_compass"
            android:tint="@color/secondary_green" />
    </item>
</layer-list>
