# Example local.properties for local development
sdk.dir=YOUR_SDK_DIR

# Local API host used by build (default for Android emulator)
LOCAL_API_IP=10.0.2.2

# Map style
MAPLIBRE_STYLE_URL=https://demotiles.maplibre.org/style.json

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name

# Optional overrides (uncomment if needed)
# LOCAL_API_PORT=8080
# LOCAL_API_PROTOCOL=http

# NOTE: Release signing uses environment variables (not this file):
# SIGNING_STORE_PASSWORD, SIGNING_KEY_ALIAS, SIGNING_KEY_PASSWORD