<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/router"
    app:startDestination="@id/nav_map"
    app:defaultNavHost="true">

    <fragment
        android:id="@+id/nav_map"
        android:name="com.bif.app.feature.map.main.MapEntryFragment"
        android:label="Map"
        app:route="/map"
        tools:layout="@layout/fragment_map_entry">

        <deepLink app:uri="app://bif.app/map" />
    </fragment>

    <fragment
        android:id="@+id/nav_favorites"
        android:name="com.bif.app.feature.favorites.FavoritesFragment"
        android:label="Favorites"
        app:route="/favorites"
        tools:layout="@layout/fragment_favorites">

        <deepLink app:uri="app://bif.app/favorites" />
    </fragment>

    <fragment
        android:id="@+id/nav_favorite_detail"
        android:name="com.bif.app.feature.favorites.FavoriteDetailFragment"
        android:label="Details"
        app:route="/favorites/detail"
        tools:layout="@layout/fragment_favorite_detail">

        <argument android:name="favId" app:argType="integer" android:defaultValue="0" />
        <argument android:name="favName" app:argType="string" android:defaultValue="" />
        <argument android:name="favAddress" app:argType="string" android:defaultValue="" />
        <argument android:name="favDescription" app:argType="string" android:defaultValue="" />
        <argument android:name="favNotes" app:argType="string" android:defaultValue="" />
        <argument android:name="favRating" app:argType="integer" android:defaultValue="0" />
        <argument android:name="favLatitude" app:argType="string" android:defaultValue="" />
        <argument android:name="favLongitude" app:argType="string" android:defaultValue="" />

        <deepLink
            app:uri="app://bif.app/favorites/detail?favId={favId}&amp;favName={favName}&amp;favAddress={favAddress}&amp;favDescription={favDescription}&amp;favNotes={favNotes}&amp;favRating={favRating}&amp;favLatitude={favLatitude}&amp;favLongitude={favLongitude}" />
    </fragment>

    <fragment
        android:id="@+id/nav_social"
        android:name="com.bif.app.feature.social.SocialFragment"
        android:label="Social"
        app:route="/social"
        tools:layout="@layout/fragment_social">

        <deepLink app:uri="app://bif.app/social" />
    </fragment>

    <fragment
        android:id="@+id/nav_profile"
        android:name="com.bif.app.feature.profile.ProfileFragment"
        android:label="Profile"
        app:route="/profile"
        tools:layout="@layout/fragment_profile">

        <deepLink app:uri="app://bif.app/profile" />
    </fragment>

    <fragment
        android:id="@+id/nav_login"
        android:name="com.bif.app.feature.auth.LoginFragment"
        android:label="Login"
        app:route="/login"
        tools:layout="@layout/fragment_login">

        <deepLink app:uri="app://bif.app/login" />
    </fragment>

    <fragment
        android:id="@+id/nav_register"
        android:name="com.bif.app.feature.auth.RegisterFragment"
        android:label="Register"
        app:route="/register"
        tools:layout="@layout/fragment_register">

        <deepLink app:uri="app://bif.app/register" />
    </fragment>

    <fragment
        android:id="@+id/nav_personal_info"
        android:name="com.bif.app.feature.profile.PersonalInfoFragment"
        android:label="Personal Information"
        app:route="/profile/personal-info"
        tools:layout="@layout/fragment_personal_info">

        <deepLink app:uri="app://bif.app/profile/personal-info" />
    </fragment>
    <fragment
        android:id="@+id/nav_group_detail"
        android:name="com.bif.app.feature.social.GroupDetailFragment"
        android:label="Group Detail"
        app:route="/social/group-detail"
        tools:layout="@layout/fragment_group_detail">

        <argument android:name="groupId" app:argType="string" android:defaultValue="" />

        <deepLink app:uri="app://bif.app/social/group-detail?groupId={groupId}" />
    </fragment>

    <fragment
        android:id="@+id/nav_social_chat"
        android:name="com.bif.app.feature.social.CommonChatFragment"
        android:label="Chat"
        app:route="/social/chat"
        tools:layout="@layout/fragment_common_chat">

        <argument android:name="chatType" app:argType="string" android:defaultValue="friend" />
        <argument android:name="chatId" app:argType="string" android:defaultValue="" />
        <argument android:name="chatName" app:argType="string" android:defaultValue="" />
        <argument android:name="avatarLetter" app:argType="string" android:defaultValue="?" />
        <argument android:name="avatarColor" app:argType="integer" android:defaultValue="0" />
        <argument android:name="memberCount" app:argType="integer" android:defaultValue="0" />
        <argument android:name="sharedPlaceName" app:argType="string" android:defaultValue="" />
        <argument android:name="sharedPlaceAddress" app:argType="string" android:defaultValue="" />
        <argument android:name="sharedPlaceLink" app:argType="string" android:defaultValue="" />

        <deepLink app:uri="app://bif.app/social/chat?chatType={chatType}&amp;chatId={chatId}&amp;chatName={chatName}&amp;avatarLetter={avatarLetter}&amp;avatarColor={avatarColor}&amp;memberCount={memberCount}&amp;sharedPlaceName={sharedPlaceName}&amp;sharedPlaceAddress={sharedPlaceAddress}&amp;sharedPlaceLink={sharedPlaceLink}" />
    </fragment>

    <fragment
        android:id="@+id/nav_friend_settings_locations"
        android:name="com.bif.app.feature.social.FriendSettingsLocationsFragment"
        android:label="Friend Shared Locations"
        app:route="/social/friend-settings/locations"
        tools:layout="@layout/fragment_friend_settings_locations">

        <argument android:name="friendId" app:argType="string" android:defaultValue="" />
        <argument android:name="friendName" app:argType="string" android:defaultValue="" />
        <argument android:name="avatarLetter" app:argType="string" android:defaultValue="?" />
        <argument android:name="avatarColor" app:argType="integer" android:defaultValue="0" />
        <deepLink app:uri="app://bif.app/social/friend-settings/locations?friendId={friendId}&amp;friendName={friendName}&amp;avatarLetter={avatarLetter}&amp;avatarColor={avatarColor}" />
    </fragment>

    <fragment
        android:id="@+id/nav_friend_settings_trips"
        android:name="com.bif.app.feature.social.FriendSettingsTripsFragment"
        android:label="Friend Trip Plans"
        app:route="/social/friend-settings/trips"
        tools:layout="@layout/fragment_friend_settings_trips">

        <argument android:name="friendId" app:argType="string" android:defaultValue="" />
        <argument android:name="friendName" app:argType="string" android:defaultValue="" />
        <argument android:name="avatarLetter" app:argType="string" android:defaultValue="?" />
        <argument android:name="avatarColor" app:argType="integer" android:defaultValue="0" />
        <deepLink app:uri="app://bif.app/social/friend-settings/trips?friendId={friendId}&amp;friendName={friendName}&amp;avatarLetter={avatarLetter}&amp;avatarColor={avatarColor}" />
    </fragment>

    <fragment
        android:id="@+id/nav_group_settings_plans"
        android:name="com.bif.app.feature.social.GroupSettingsPlansFragment"
        android:label="Group Plans"
        app:route="/social/group-settings/plans"
        tools:layout="@layout/fragment_group_settings_plans">

        <argument android:name="groupId" app:argType="string" android:defaultValue="" />
        <deepLink app:uri="app://bif.app/social/group-settings/plans?groupId={groupId}" />
    </fragment>

    <fragment
        android:id="@+id/nav_group_settings_locations"
        android:name="com.bif.app.feature.social.GroupSettingsLocationsFragment"
        android:label="Group Locations"
        app:route="/social/group-settings/locations"
        tools:layout="@layout/fragment_group_settings_locations">

        <argument android:name="groupId" app:argType="string" android:defaultValue="" />
        <deepLink app:uri="app://bif.app/social/group-settings/locations?groupId={groupId}" />
    </fragment>

    <fragment
        android:id="@+id/nav_group_settings_members"
        android:name="com.bif.app.feature.social.GroupSettingsMembersFragment"
        android:label="Group Members"
        app:route="/social/group-settings/members"
        tools:layout="@layout/fragment_group_settings_members">

        <argument android:name="groupId" app:argType="string" android:defaultValue="" />
        <deepLink app:uri="app://bif.app/social/group-settings/members?groupId={groupId}" />
    </fragment>

</navigation>

