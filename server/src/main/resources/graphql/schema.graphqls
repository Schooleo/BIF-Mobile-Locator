type Query {
  users: [User!]!
  user(id: ID!): User
  groups: [Group!]!
  group(id: ID!): Group
  places: [Place!]!
  place(id: ID!): Place
  favorites: [Favorite!]!
  favorite(id: ID!): Favorite
  favoritesByUser(userId: ID!): [Favorite!]!
  chatMessages: [ChatMessage!]!
  chatMessage(id: ID!): ChatMessage
  chatMessagesByGroup(groupId: ID!): [ChatMessage!]!
  tripPlans: [TripPlan!]!
  tripPlan(id: ID!): TripPlan
  tripPlansByGroup(groupId: ID!): [TripPlan!]!
  syncPreview(lastPulledVersion: Int): SyncResponse!
}

type Mutation {
  upsertUser(input: UserInput!): User!
  deleteUser(id: ID!): Boolean!
  upsertGroup(input: GroupInput!): Group!
  deleteGroup(id: ID!): Boolean!
  upsertPlace(input: PlaceInput!): Place!
  deletePlace(id: ID!): Boolean!
  upsertFavorite(input: FavoriteInput!): Favorite!
  deleteFavorite(id: ID!): Boolean!
  upsertChatMessage(input: ChatMessageInput!): ChatMessage!
  deleteChatMessage(id: ID!): Boolean!
  upsertTripPlan(input: TripPlanInput!): TripPlan!
  deleteTripPlan(id: ID!): Boolean!
  sync(input: SyncRequestInput!): SyncResponse!
}

type User {
  id: ID
  name: String
  email: String
  avatarLetter: String
  avatarColor: Int
  isOnline: Boolean
}

type Group {
  id: ID
  name: String
  avatarLetter: String
  avatarColor: Int
  memberCount: Int
  memberIds: [ID!]
  ownerId: ID
}

type Place {
  id: ID
  name: String
  address: String
  rating: Float
  location: Location
  tags: [String!]
}

type Favorite {
  id: ID
  name: String
  location: Location
  address: String
  description: String
  notes: String
  rating: Int
  imagePath: String
  userId: ID
}

type ChatMessage {
  id: ID
  groupId: ID
  senderUserId: ID
  content: String
  sentAt: String
  clientMessageId: String
}

type TripPlan {
  id: ID
  groupId: ID
  title: String
  description: String
  startAt: String
  endAt: String
  stops: [TripStop!]
  participantIds: [ID!]
}

type TripStop {
  title: String
  note: String
  location: Location
  arrivalTime: String
  departureTime: String
  orderIndex: Int
}

type Location {
  latitude: Float
  longitude: Float
}

type SyncResponse {
  currentServerVersion: Int!
  pulledChanges: [SyncChange!]!
}

type SyncChange {
  entityType: String
  entityId: String
  serverVersion: Int
  operation: String
}

input UserInput {
  id: ID
  name: String
  email: String
  avatarLetter: String
  avatarColor: Int
  isOnline: Boolean
}

input GroupInput {
  id: ID
  name: String
  avatarLetter: String
  avatarColor: Int
  memberCount: Int
  memberIds: [ID!]
  ownerId: ID
}

input PlaceInput {
  id: ID
  name: String
  address: String
  rating: Float
  location: LocationInput
  tags: [String!]
}

input FavoriteInput {
  id: ID
  name: String
  location: LocationInput
  address: String
  description: String
  notes: String
  rating: Int
  imagePath: String
  userId: ID
}

input ChatMessageInput {
  id: ID
  groupId: ID
  senderUserId: ID
  content: String
  sentAt: String
  clientMessageId: String
}

input TripPlanInput {
  id: ID
  groupId: ID
  title: String
  description: String
  startAt: String
  endAt: String
  stops: [TripStopInput!]
  participantIds: [ID!]
}

input TripStopInput {
  title: String
  note: String
  location: LocationInput
  arrivalTime: String
  departureTime: String
  orderIndex: Int
}

input LocationInput {
  latitude: Float
  longitude: Float
}

input SyncRequestInput {
  userId: ID
  deviceId: ID
  lastPulledVersion: Int!
  pushedChanges: [SyncChangeInput!]
}

input SyncChangeInput {
  entityType: String
  entityId: String
  serverVersion: Int
  operation: String
}
